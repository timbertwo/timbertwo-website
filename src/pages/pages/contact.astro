---
import Base from '../../layouts/Base.astro';
import raw from '../../html/pages/pages/contact.html?raw';
import form from '../../html/enquiry-form.html?raw';

const path = '/pages/contact';
const title = "Contact. – Timber Two Joinery";
const description = "";
const content = raw.replace('<!-- ENQUIRY_FORM -->', form.split('{PAGE}').join(path));
---
<Base title={title} description={description} path={path} bodyClass="contact page gradient">
  <Fragment set:html={content} />
</Base>
